DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# PostgreSQL is the intended database. Use DATABASE_URL from Supabase or a local PostgreSQL server.
DATABASE_URL=postgresql://postgres:password@localhost:5432/insightflow_django
# Optional local demo fallback: set USE_SQLITE=true
USE_SQLITE=true
