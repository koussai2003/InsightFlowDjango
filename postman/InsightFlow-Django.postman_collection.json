{
  "info": {"name": "InsightFlow Django API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://127.0.0.1:8021"},{"key":"csrf","value":""},{"key":"projectId","value":""}],
  "item": [
    {"name":"GET health","request":{"method":"GET","url":"{{baseUrl}}/api/health/"}},
    {"name":"GET CSRF token","event":[{"listen":"test","script":{"exec":["const j=pm.response.json(); pm.collectionVariables.set('csrf',j.csrfToken); pm.collectionVariables.set('testEmail','rayen+'+Date.now()+'@example.test');"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/csrf/"}},
    {"name":"POST sign up","event":[{"listen":"test","script":{"exec":["if(pm.response.code===201){pm.collectionVariables.set('projectId',pm.response.json().project_id);}"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRFToken","value":"{{csrf}}"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"ChangeMe123!\",\n  \"confirm_password\": \"ChangeMe123!\",\n  \"first_name\": \"Rayen\"\n}"},"url":"{{baseUrl}}/api/auth/signup/"}},
    {"name":"POST sign in","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRFToken","value":"{{csrf}}"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"ChangeMe123!\"\n}"},"url":"{{baseUrl}}/api/auth/login/"}},
    {"name":"GET refreshed CSRF token after login","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('csrf',pm.response.json().csrfToken);"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/csrf/"}},
    {"name":"GET current user","request":{"method":"GET","url":"{{baseUrl}}/api/me/"}},
    {"name":"GET projects","request":{"method":"GET","url":"{{baseUrl}}/api/projects/"}},
    {"name":"POST create project","event":[{"listen":"test","script":{"exec":["if(pm.response.code===201){pm.collectionVariables.set('projectId',pm.response.json().id);}"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRFToken","value":"{{csrf}}"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"CSV profiling demo\"\n}"},"url":"{{baseUrl}}/api/projects/"}},
    {"name":"GET project detail","request":{"method":"GET","url":"{{baseUrl}}/api/projects/{{projectId}}/"}},
    {"name":"POST sign out","request":{"method":"POST","header":[{"key":"X-CSRFToken","value":"{{csrf}}"}],"url":"{{baseUrl}}/api/auth/logout/"}}
  ]
}
